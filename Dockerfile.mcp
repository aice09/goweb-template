FROM golang:1.23-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/fast-crud-mcp ./cmd/mcp

FROM gcr.io/distroless/static-debian12:nonroot
USER nonroot:nonroot
COPY --from=build --chown=nonroot:nonroot /out/fast-crud-mcp /fast-crud-mcp
ENTRYPOINT ["/fast-crud-mcp"]
