# ============================================================
# Application
# ============================================================
APP_ENV=development
APP_NAME=Fast CRUD
HTTP_ADDR=:3000
PUBLIC_BASE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TIMEZONE=Asia/Manila

# ============================================================
# PostgreSQL
# Compose interpolates POSTGRES_PASSWORD for the local database.
# Use TLS (sslmode=verify-full) and managed secrets in production.
# ============================================================
POSTGRES_DB=appdb
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DB_PASSWORD
DATABASE_URL=postgres://app:REPLACE_WITH_UNIQUE_DB_PASSWORD@postgres:5432/appdb?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=10s
DB_MIGRATIONS_DIR=migrations

# ============================================================
# Redis
# ============================================================
REDIS_ADDR=redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_WITH_UNIQUE_REDIS_PASSWORD
REDIS_DB=0
REDIS_TLS=false
CACHE_TTL=60s

# ============================================================
# NATS JetStream (durable events)
# ============================================================
NATS_URL=nats://nats:4222
NATS_USERNAME=
NATS_PASSWORD=REPLACE_WITH_UNIQUE_NATS_PASSWORD
NATS_TOKEN=
NATS_TLS=false
NATS_STREAM=FASTCRUD_EVENTS
NATS_SUBJECT_PREFIX=items
NATS_DURABLE_CONSUMER=fast-crud-workers
NATS_ACK_WAIT=30s
NATS_MAX_DELIVER=10
NATS_MAX_AGE=168h
NATS_REPLICAS=1
NATS_PUBLISH_TIMEOUT=5s
# For production use NATS credentials and TLS; don't expose the monitoring port publicly.

# ============================================================
# Authentication mode
# local | ldap | oidc | hybrid
# LDAP/OIDC must be configured and tested before selecting them.
# ============================================================
AUTH_MODE=local
AUTH_ALLOW_LOCAL_FALLBACK=false
AUTH_REQUIRE_MFA=false
AUTH_SESSION_IDLE_TTL=30m
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m

# Local session/JWT signing. Generate independent random values.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_TTL=12h
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
JWT_ISSUER=fast-crud
JWT_AUDIENCE=fast-crud-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h
JWT_SIGNING_KEY=REPLACE_WITH_SEPARATE_RANDOM_JWT_SIGNING_KEY
JWT_SIGNING_ALGORITHM=HS256

# ============================================================
# Keycloak / OIDC SSO
# Configure Keycloak realm/client redirect URI:
# http://localhost:3000/auth/oidc/callback
# Production must use HTTPS and exact redirect URIs.
# ============================================================
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://keycloak.example.com/realms/example
OIDC_CLIENT_ID=fast-crud
OIDC_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
OIDC_REDIRECT_URL=http://localhost:3000/auth/oidc/callback
OIDC_SCOPES=openid,profile,email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=fast-crud-admins
OIDC_ALLOWED_CLOCK_SKEW=60s
OIDC_REQUIRE_EMAIL_VERIFIED=true
OIDC_PKCE=true
OIDC_STATE_TTL=10m
# MFA is enforced in Keycloak authentication flows, not by this env flag alone.

# ============================================================
# LDAP / Active Directory
# Use LDAPS or StartTLS in production; never send passwords over plaintext LDAP.
# ============================================================
LDAP_ENABLED=false
LDAP_URL=ldaps://ldap.example.com:636
LDAP_STARTTLS=false
LDAP_INSECURE_SKIP_VERIFY=false
LDAP_CA_FILE=/run/secrets/ldap-ca.crt
LDAP_BASE_DN=ou=People,dc=example,dc=com
LDAP_BIND_DN=cn=svc-fast-crud,ou=ServiceAccounts,dc=example,dc=com
LDAP_BIND_PASSWORD=REPLACE_WITH_LDAP_SERVICE_ACCOUNT_PASSWORD
LDAP_USER_FILTER=(uid=%s)
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_GROUPS_ATTRIBUTE=memberOf
LDAP_ADMIN_GROUP_DN=cn=fast-crud-admins,ou=Groups,dc=example,dc=com
LDAP_CONNECT_TIMEOUT=5s

# ============================================================
# MFA
# For OIDC/Keycloak, enforce TOTP/WebAuthn in Keycloak.
# Native TOTP settings are reserved for an application-managed MFA implementation.
# ============================================================
MFA_ENABLED=false
MFA_ISSUER=Fast CRUD
MFA_TOTP_REQUIRED_FOR_ADMINS=true
MFA_RECOVERY_CODES_COUNT=10

# ============================================================
# Initial setup wizard
# Setup token is a one-time bootstrap gate, not a replacement for network controls.
# ============================================================
SETUP_TOKEN=REPLACE_WITH_LONG_RANDOM_SETUP_TOKEN

# ============================================================
# Strict Content Security Policy
# Self-host/vendor frontend assets for production. These defaults assume same-origin assets.
# CSP_NONCE_ENABLED=false
# Add only origins that you explicitly trust; avoid unsafe-inline/unsafe-eval.
# ============================================================
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
CSP_FRAME_ANCESTORS='none'
CSP_CONNECT_SRC='self'
CSP_IMG_SRC='self' data: blob:
CSP_STYLE_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_FONT_SRC='self' data:
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
REFERRER_POLICY=no-referrer
PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()

# ============================================================
# Audit logging
# ============================================================
AUDIT_ENABLED=true
AUDIT_LOG_REQUESTS=false
AUDIT_RETENTION_DAYS=365
AUDIT_INCLUDE_CLIENT_IP=true
AUDIT_INCLUDE_USER_AGENT=true

# ============================================================
# S3-compatible object storage for assets and backups
# Supports AWS S3, MinIO, Ceph RGW, and compatible endpoints.
# ============================================================
S3_ENABLED=false
S3_REGION=ap-southeast-1
S3_BUCKET_ASSETS=fast-crud-assets
S3_BUCKET_BACKUPS=fast-crud-backups
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_SESSION_TOKEN=
S3_USE_PATH_STYLE=false
S3_FORCE_PATH_STYLE=false
S3_TLS=true
S3_ASSET_PREFIX=assets/
S3_BACKUP_PREFIX=postgres/
S3_PRESIGNED_URL_TTL=10m
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=

# ============================================================
# Database backup and restore
# Run scripts/backup-postgres.sh and scripts/restore-postgres.sh from a host
# with pg_dump/pg_restore and AWS CLI installed.
# ============================================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DIR=./backups
BACKUP_COMPRESSION_LEVEL=6
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_YOUR_PUBLIC_RECIPIENT
BACKUP_VERIFY_AFTER_UPLOAD=true
RESTORE_REQUIRE_CONFIRMATION=true
RESTORE_TARGET_DATABASE=appdb
# Store age private identity outside the repository and restore host, e.g. /run/secrets/backup-age-identity.
BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup-age-identity

# ============================================================
# Observability / monitoring
# ============================================================
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_AUTH_TOKEN=REPLACE_WITH_METRICS_BEARER_TOKEN
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=fast-crud
OTEL_TRACES_SAMPLE_RATIO=0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_GRAFANA_PASSWORD

# ============================================================
# Deployment
# ============================================================
APP_READ_TIMEOUT=5s
APP_WRITE_TIMEOUT=5s
APP_IDLE_TIMEOUT=60s
APP_BODY_LIMIT_BYTES=1048576


# ============================================================
# MCP server (stdio; launched by a trusted MCP host)
# Keep mutations disabled by default. Prefer a PostgreSQL role with SELECT-only access.
# ============================================================
MCP_ENABLE_MUTATIONS=false
MCP_DATABASE_URL=postgres://mcp_readonly:REPLACE_WITH_PASSWORD@postgres:5432/appdb?sslmode=disable

# ============================================================
# Application-level S3 / MinIO object storage (optional)
# Set S3_ENABLED=true to expose authenticated /api/v1/files endpoints.
# S3 bucket must already exist; use a dedicated bucket and least-privilege IAM user.
# ============================================================
S3_ENABLED=false
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_BUCKET=fast-crud-files
S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
S3_USE_SSL=false

# ============================================================
# Outbound webhooks and Microsoft Teams notifications (optional)
# WEBHOOK_URLS is a comma-separated list of HTTPS endpoints.
# Receivers should validate X-FastCRUD-Signature when a secret is configured.
# Teams webhook URL should be created through an approved Teams Workflows webhook.
# ============================================================
WEBHOOK_URLS=
WEBHOOK_HMAC_SECRET=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET
TEAMS_WEBHOOK_URL=

# ============================================================
# SMTP email notifications (optional)
# Prefer an SMTP relay with STARTTLS on port 587.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=fast-crud@example.com
EMAIL_NOTIFY_TO=
